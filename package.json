{
  "name": "remark-lint-check-toc",
  "version": "1.0.1",
  "description": "Ensure that your Markdown TOC is correct",
  "keywords": [
    "remark",
    "remark-plugin",
    "lint",
    "markdown",
    "remark-lint"
  ],
  "author": "Ilya Titov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilyatitovich/remark-lint-check-toc.git"
  },
  "sideEffects": false,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "test": "pnpm run /^test:/",
    "test:lint": "eslint .",
    "test:coverage": "c8 pnpm bnt",
    "test:plugin": "node ./test/test.js"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "better-node-test": "^1.0.0",
    "c8": "^12.0.0",
    "clean-publish": "^7.1.0",
    "eslint": "^10.14.0",
    "remark": "^15.0.1"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "c8": {
    "exclude": [
      "**/*.test.*",
      "test/*"
    ],
    "lines": 100,
    "check-coverage": true,
    "reporter": [
      "text",
      "lcov"
    ],
    "skip-full": true,
    "clean": true
  },
  "prettier": {
    "arrowParens": "avoid",
    "jsxSingleQuote": false,
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  },
  "clean-publish": {
    "cleanDocs": true
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "unified-lint-rule": "^3.0.1",
    "unist-util-find": "^3.0.0",
    "unist-util-visit": "^5.2.0",
    "unist-util-visit-parents": "^6.1.0"
  }
}
